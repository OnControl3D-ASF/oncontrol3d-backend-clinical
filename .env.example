# OnControl3D - Clinical Service
# Copy to .env (git-ignored) and fill in the values. Never commit real secrets.

# --- Required: the service does NOT start without them ---
DB_PASSWORD=
# At least 32 bytes (256 bits). Generate: openssl rand -hex 32
JWT_SECRET=

# --- Optional (defaults shown) ---
# DB_URL=jdbc:postgresql://localhost:5432/OnControlSem
# DB_USERNAME=postgres
# PORT=8081
# IMAGING_SERVICE_URL=http://localhost:8001
# ORTHANC_URL=http://localhost:8042

# --- Demo data (local development only) ---
# Disabled by default. When enabled, SEED_USER_PASSWORD is required.
# APP_DATA_SEEDING_ENABLED=false
# SEED_USER_PASSWORD=
