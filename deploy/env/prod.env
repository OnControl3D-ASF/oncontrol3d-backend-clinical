# Non-secret, per-environment settings for deploy/k8s/clinical.yaml
# Min 1..2 replicas (capacity on 2 nodes); maxUnavailable 0 keeps rolling updates zero-downtime.
NAMESPACE=oncontrol-prod
DB_NAME=oncontrol_prod
MIN_REPLICAS=1
MAX_REPLICAS=2
SEEDING_ENABLED=false
CPU_REQUEST=250m
CPU_LIMIT=1000m
MEMORY_REQUEST=640Mi
MEMORY_LIMIT=1Gi
